# Consumer ProGuard rules for @bugsnag/react-native.
#
# This file is referenced by `consumerProguardFiles` in build.gradle and must exist: Android Gradle
# Plugin 9+ (React Native 0.87+) fails the build when a consumer ProGuard file is missing.
#
# The rules required by bugsnag-android are bundled in the bugsnag-android AARs themselves, so no
# additional rules are needed here.
